# Copy to .env and fill in. Feature switches and the measurement behind every
# default are in src/config.ts.

# --- Required ---------------------------------------------------------------
PORT=3000
# Token of the Bale bot (from @botfather in Bale).
BALE_TOKEN=
# PostgreSQL from compose.yaml listens on host port 5433.
DATABASE_URL=postgres://daneshjo:change-me@localhost:5433/daneshjohandbot
LLM_URL=http://localhost:11434/api/chat
LLM_MODEL=qwen3.5:9b
EMBEDDING_MODEL=bge-m3

# Used by compose.yaml for the postgres, bot and backup services.
POSTGRES_USER=daneshjo
POSTGRES_PASSWORD=change-me
POSTGRES_DB=daneshjohandbot

# --- Optional (defaults shown) ----------------------------------------------
# OLLAMA_EMBED_URL=http://localhost:11434/api/embed
# How long Ollama keeps the models loaded: a duration, or -1 for always.
# LLM_KEEP_ALIVE=30m
# LOG_LEVEL=info

# RERANKER_ENABLED=true
# RERANKER_URL=http://localhost:8081/v1/rerank
# RERANKER_MIN_SCORE=

# ENRICHMENT=true
# QUESTION_INDEX=true

# OCR_ENABLED=true
# OCR_MAX_PAGES=
# OCR_RENDER_WIDTH=1400
# OCR_TILE_PIXELS=1414000
# OCR_CROP=true
# OCR_PROMPT=fa
# OCR_REPAIR=both

# Measured with no gain, off by default (see src/config.ts before turning on).
# HYBRID_SEARCH=false
# SECTION_EXPANSION=false
# CHUNK_CONTEXT=false
# CHUNK_CROSS_PAGE=false
# CHUNK_SEMANTIC=false
# CHUNK_STRIP_BOILERPLATE=true
# CHUNK_TITLE_IN_EMBEDDING=true
